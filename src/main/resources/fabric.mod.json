{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "icon": "icon.png",
    "description": "${mod_description}",
    "authors": [
        "Polyfrost"
    ],
    "environment": "client",
    "entrypoints": {
        "client": [
            "org.polyfrost.oneclient.OneClientEntrypoint"
        ]
    },
    "mixins": [
        "mixins.${mod_id}.json"
    ],
    "depends": {
        "minecraft": "${minor_mc_version}",
        "fabricloader": ">=0.16.0",
        "java": ">=21",
        "fabric-language-kotlin": ">=1.14.1",
        "oneconfigv1": ">=${oneconfig_version}",
        "compose-multiplatform": ">=1.0.6"
    },
    "breaks": {
        "polyplus": "*"
    }
}
